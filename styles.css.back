@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700;800&family=Oswald:wght@400;500;600;700&display=swap');
:root{--bg:#06101e;--panel:#0b1a2d;--panel2:#10233a;--text:#f4f7fb;--muted:#a7b5c8;--line:rgba(188,209,236,.16);--blue:#4e9dff;--gold:#ffd45e;--max:1200px}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{margin:0;background:var(--bg);color:var(--text);font-family:'Noto Sans JP',sans-serif;line-height:1.7}a{color:inherit;text-decoration:none}.site-header{height:78px;padding:0 max(24px,calc((100vw - var(--max))/2));display:flex;align-items:center;justify-content:space-between;background:rgba(4,12,23,.95);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:20;backdrop-filter:blur(12px)}.brand{display:flex;align-items:center;gap:12px}.brand-mark{display:grid;place-items:center;width:42px;height:42px;border:1px solid var(--gold);color:var(--gold);font:600 17px Oswald,sans-serif;letter-spacing:-1px}.brand-copy{display:flex;flex-direction:column;line-height:1.3}.brand-copy strong,.footer-brand{font:600 14px Oswald,sans-serif;letter-spacing:1.4px}.brand-copy small{color:var(--muted);font-size:10px;letter-spacing:.08em;margin-top:4px}.main-nav{display:flex;gap:32px;font-size:13px;color:#d6dfeb}.main-nav a:hover{color:var(--gold)}.menu-toggle{display:none;background:none;border:0;color:white;font-size:25px}.hero{height:min(670px,70vw);min-height:510px;position:relative;overflow:hidden;background:#10233a}.hero-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 48%;opacity:.72}.hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(4,12,23,.94) 0%,rgba(4,12,23,.79) 34%,rgba(4,12,23,.25) 72%,rgba(4,12,23,.45) 100%),linear-gradient(0deg,#06101e 0%,transparent 32%)}.hero-content{position:relative;z-index:1;width:min(var(--max),calc(100% - 48px));margin:0 auto;padding-top:125px}.eyebrow,.section-kicker{color:var(--gold);font:500 12px Oswald,sans-serif;letter-spacing:2.4px}.hero h1{font-size:clamp(34px,4.2vw,58px);line-height:1.35;letter-spacing:.02em;margin:18px 0 20px;font-weight:800;text-shadow:0 3px 25px #000}.hero h1 span{color:#8fc2ff}.hero-lead{font-size:15px;color:#e1e9f4;line-height:2}.primary-button{display:inline-flex;align-items:center;gap:26px;background:var(--gold);color:#101a28;padding:13px 20px;font-weight:800;font-size:13px;margin-top:20px;transition:transform .2s,background .2s}.primary-button:hover{transform:translateY(-2px);background:#ffe28a}.primary-button span{font-size:18px}.hero-caption{position:absolute;right:4%;bottom:36px;font:500 13px Oswald,sans-serif;letter-spacing:2px;color:#e9f2ff}.hero-caption span{display:block;text-align:right;font:400 11px 'Noto Sans JP',sans-serif;letter-spacing:.08em;color:#c3d2e4}.section-wrap{width:min(var(--max),calc(100% - 48px));margin:0 auto}.intro{display:grid;grid-template-columns:.8fr 1.2fr;gap:70px;padding-top:94px;padding-bottom:95px;align-items:center}.intro h2,.section-heading h2,.closing h2{font-size:clamp(26px,3vw,36px);line-height:1.5;margin:10px 0;font-weight:700}.intro-text{color:#c0ccdb;font-size:14px;line-height:2.2;border-left:2px solid var(--gold);padding-left:28px;margin:0}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:30px}.section-heading h2{margin-bottom:0}.section-heading>p{color:var(--muted);font-size:12px}.categories{padding-bottom:100px}.category-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.category-card{min-height:145px;padding:22px;background:linear-gradient(135deg,#10243c,#0a1728);border:1px solid var(--line);display:flex;flex-direction:column;transition:border-color .2s,transform .2s}.category-card:hover{border-color:var(--blue);transform:translateY(-3px)}.category-icon{color:var(--gold);font-size:23px;line-height:1.2;margin-bottom:12px}.category-card strong{font-size:15px}.category-card small{color:var(--muted);font-size:11px;margin-top:6px}.content-section{padding:84px 0 90px;background:#091625;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.filter-row{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 28px}.filter-chip{padding:8px 15px;background:transparent;color:#b7c5d6;border:1px solid var(--line);font:500 12px 'Noto Sans JP',sans-serif;cursor:pointer}.filter-chip:hover,.filter-chip.active{background:var(--gold);border-color:var(--gold);color:#101a28}.content-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.content-card{min-width:0;background:#0d1c2e;border:1px solid var(--line);transition:transform .2s,border-color .2s;overflow:hidden}.content-card:hover{transform:translateY(-4px);border-color:rgba(78,157,255,.7)}.content-card[hidden]{display:none}.card-art{height:165px;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:space-between;padding:17px;background:radial-gradient(ellipse at 80% 15%,rgba(67,152,255,.4),transparent 38%),linear-gradient(135deg,#102b49,#050c17)}.card-art:before{content:"";position:absolute;width:180px;height:180px;border:1px solid rgba(129,190,255,.3);border-radius:50%;right:-25px;bottom:-90px;box-shadow:0 0 0 18px rgba(65,143,231,.06),0 0 0 40px rgba(65,143,231,.04)}.card-art:after{content:"";position:absolute;left:0;right:0;bottom:25px;height:1px;background:linear-gradient(90deg,transparent,#67b8ff,transparent);transform:rotate(-12deg)}.card-art span,.card-art b{position:relative;z-index:1}.card-art span{font:500 11px Oswald,sans-serif;letter-spacing:2px;color:#91c6ff}.card-art b{font-size:20px;line-height:1.4;max-width:85%;text-shadow:0 2px 8px #000}.art-heat{background:radial-gradient(ellipse at 70% 35%,rgba(255,89,89,.3),transparent 35%),linear-gradient(135deg,#14253b,#07101d)}.art-global{background:radial-gradient(ellipse at 70% 35%,rgba(58,220,202,.28),transparent 35%),linear-gradient(135deg,#102d43,#07101d)}.art-market{background:radial-gradient(ellipse at 70% 35%,rgba(89,255,164,.22),transparent 35%),linear-gradient(135deg,#102b37,#07101d)}.art-chart{background:radial-gradient(ellipse at 70% 35%,rgba(255,195,75,.25),transparent 35%),linear-gradient(135deg,#302a27,#07101d)}.art-sim{background:radial-gradient(ellipse at 70% 35%,rgba(164,117,255,.3),transparent 35%),linear-gradient(135deg,#202344,#07101d)}.art-policy{background:radial-gradient(ellipse at 70% 35%,rgba(255,212,94,.22),transparent 35%),linear-gradient(135deg,#302c25,#07101d)}.art-retire{background:radial-gradient(ellipse at 70% 35%,rgba(81,169,255,.26),transparent 35%),linear-gradient(135deg,#183047,#07101d)}.art-flow{background:radial-gradient(ellipse at 70% 35%,rgba(255,95,130,.22),transparent 35%),linear-gradient(135deg,#302239,#07101d)}.art-fx{background:radial-gradient(ellipse at 70% 35%,rgba(80,224,180,.22),transparent 35%),linear-gradient(135deg,#12352f,#07101d)}.card-body{padding:20px}.tag{display:inline-block;color:var(--gold);font-size:10px;letter-spacing:.05em}.card-body h3{font-size:16px;margin:8px 0}.card-body p{color:var(--muted);font-size:12px;line-height:1.9;min-height:46px;margin:0 0 16px}.card-link{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--line);padding-top:12px;font-size:11px;color:#dbe7f5}.card-link b{font-size:17px;color:var(--blue)}.placeholder-note{font-size:11px;color:#8495aa;margin-top:22px}.closing{text-align:center;padding-top:95px;padding-bottom:100px}.closing h2{font-size:clamp(28px,4vw,42px)}.closing h2 span{display:block;color:#8fc2ff}.closing>p:not(.section-kicker){font-size:13px;color:var(--muted);margin-top:18px}.site-footer{border-top:1px solid var(--line);padding:25px max(24px,calc((100vw - var(--max))/2));display:flex;align-items:center;gap:18px;color:var(--muted);font-size:11px}.footer-brand{color:var(--text)}.site-footer small{margin-left:auto;font-size:10px}@media(max-width:800px){.main-nav{gap:15px}.hero{min-height:490px;height:70vw}.hero-content{padding-top:100px}.hero-shade{background:linear-gradient(90deg,rgba(4,12,23,.91),rgba(4,12,23,.52)),linear-gradient(0deg,#06101e 0%,transparent 35%)}.intro{gap:30px}.category-grid{grid-template-columns:repeat(2,1fr)}.content-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.site-header{height:66px;padding:0 18px}.brand-mark{width:36px;height:36px}.brand-copy strong{font-size:12px}.menu-toggle{display:block}.main-nav{display:none;position:absolute;top:65px;left:0;right:0;padding:18px;background:#071426;border-bottom:1px solid var(--line);flex-direction:column;gap:18px}.main-nav.open{display:flex}.hero{height:620px;min-height:0}.hero-image{object-position:58% center}.hero-content{width:calc(100% - 36px);padding-top:92px}.hero h1{font-size:34px}.hero-lead{font-size:12px}.hero-caption{right:18px;bottom:26px;font-size:10px}.section-wrap{width:calc(100% - 36px)}.intro{grid-template-columns:1fr;gap:16px;padding-top:66px;padding-bottom:70px}.intro-text{font-size:12px;padding-left:18px}.section-heading{align-items:start;flex-direction:column;gap:8px}.section-heading>p{margin:0}.categories{padding-bottom:70px}.category-card{padding:16px;min-height:135px}.category-card strong{font-size:13px}.category-card small{font-size:10px}.content-section{padding:65px 0}.content-grid{grid-template-columns:1fr;gap:14px}.card-art{height:150px}.card-body p{min-height:0}.closing{padding-top:70px;padding-bottom:75px}.site-footer{padding:22px 18px;flex-wrap:wrap;gap:8px 14px}.site-footer small{width:100%;margin:6px 0 0}}


/* Latest articles generated from articles.json */
.latest-articles { padding-top: 72px; padding-bottom: 72px; }
.article-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; margin-top: 28px; }
.article-card { min-width: 0; border: 1px solid rgba(150, 180, 210, .2); border-radius: 14px; overflow: hidden; background: linear-gradient(145deg, rgba(17, 38, 60, .92), rgba(7, 20, 38, .96)); transition: transform .2s ease, border-color .2s ease; }
.article-card:hover { transform: translateY(-3px); border-color: rgba(94, 177, 255, .65); }
.article-card-link { display: block; height: 100%; padding: 24px; color: inherit; text-decoration: none; }
.article-card h3 { margin: 12px 0 8px; font-size: 1.12rem; line-height: 1.55; }
.article-card p { color: var(--muted, #aebed0); line-height: 1.8; font-size: .92rem; }
.article-date { display: block; color: #8ea3b8; font-size: .8rem; margin-bottom: 10px; }
.article-card .card-link { display: inline-block; margin-top: 10px; }
.article-empty { grid-column: 1 / -1; color: #aebed0; padding: 20px 0; }
.article-index-link { margin-top: 22px; text-align: right; }
.article-index-link a { color: #9bd3ff; text-decoration: none; font-weight: 700; }
@media (max-width: 900px) { .article-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 600px) { .article-grid { grid-template-columns: 1fr; } .article-card-link { padding: 20px; } }
